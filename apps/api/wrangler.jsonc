{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-study-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "COOKIE_DOMAIN": "",
    "CORS_ORIGINS": "https://english.ikber.cc,https://weitaoyan-english-study-apps-web.yanweitao.workers.dev,http://localhost:3000,http://127.0.0.1:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-study",
      "database_id": "c125b631-7ef8-4701-a3f4-c8d62f2fa8d1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "english-study-images"
    }
  ],
  "routes": [
    {
      "pattern": "api.english.ikber.cc",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 16 * * *"]
  },
  "dev": {
    "port": 8787
  }
}
