{
  "name": "@english-study/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply english-study --local",
    "db:migrate:remote": "wrangler d1 migrations apply english-study --remote",
    "db:seed": "wrangler d1 execute english-study --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute english-study --remote --file=./seed.sql",
    "db:reset": "wrangler d1 execute english-study --local --file=./migrations/0001_init.sql && wrangler d1 execute english-study --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.1"
  }
}
