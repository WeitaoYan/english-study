{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-study-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "development",
    "COOKIE_DOMAIN": "",
    "CORS_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-study",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "english-study-images"
    }
  ],
  "triggers": {
    "crons": ["0 16 * * *"]
  },
  "dev": {
    "port": 8787
  }
}
